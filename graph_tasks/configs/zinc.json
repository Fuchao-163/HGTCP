{
  "dataset": "zinc",
  "task": "regression",
  "model": {
    "alpha": 0.7,
    "clusters": 8,
    "dropout": 0.0,
    "ffn_depth": 2,
    "global_layers": 1,
    "graph_pooling": "add",
    "heads": 4,
    "hidden": 92,
    "hpde_level_offset": 1,
    "local_layers": 10,
    "normalization": "batch",
    "train_eps": true,
    "use_cluster_size_bias": true
  },
  "training": {
    "batch_size": 64,
    "contrastive_weight": 0.1,
    "cpu_threads": 4,
    "epochs": 1200,
    "grad_clip": 1.0,
    "lr": 0.001,
    "lr_decay": 0.5,
    "lr_patience": 100,
    "min_lr": 0.00001,
    "num_workers": 2,
    "optimizer": "adam",
    "scheduler": "plateau",
    "warmup_epochs": 0,
    "weight_decay": 0.00001
  }
}
